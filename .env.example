# Copia este archivo a ".env" y completa los valores. ".env" no se sube a git.

# Firebase (Consola de Firebase > Configuración del proyecto > Tus apps > Configuración del SDK).
# Estos valores son públicos por diseño: la seguridad la dan firestore.rules y las reglas de Auth.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# URL de la aplicación web de Google Apps Script (termina en /exec). Ver docs/apps-script-setup.md.
VITE_APPS_SCRIPT_URL=

# Respaldo del botón de WhatsApp (solo dígitos con código de país, por ejemplo 50688888888).
# El número real se guarda en el admin: Ajustes > WhatsApp de la tienda.
VITE_WHATSAPP_NUMBER=
